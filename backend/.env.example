# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/campushive

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=./config/firebase-key.json
FIREBASE_STORAGE_BUCKET=campushive-storage.appspot.com

# AWS / Amazon S3 Configuration (Uses EC2 IAM Role in Production; no keys needed)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=campushive-media-2026
S3_STORAGE_ENABLED=true
S3_KEY_PREFIX=
S3_PRESIGNED_REDIRECT=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@campushive.com

# Logging
LOG_LEVEL=INFO

# ML Model Configuration
ML_MODEL_PATH=./app/ml/models/
ML_MODEL_VERSION=1.0

# Application Settings
ITEMS_PER_PAGE=20
